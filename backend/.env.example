# ==============================================================================
# XtremeCRM Backend Environment Variables (Template)
# Copy this file to .env.development or .env.production and fill in your values
# ==============================================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Connections (PostgreSQL / Neon)
# DATABASE_URL: Pooled connection string (for Express queries)
# DIRECT_URL: Direct unpooled connection string (for Prisma migrations / db push)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
COOKIE_SECRET=replace_with_a_secure_random_string_32_chars
JWT_SECRET=replace_with_a_secure_jwt_secret_key_32_chars
JWT_EXPIRES_IN=7d

# Telephony (Telnyx) — Pre-filled with dummy variables for simulation & testing
# Paste real production credentials when available from Telnyx Portal
TELNYX_API_KEY=KEY0175DUMMY_API_KEY_SIMULATION_MODE_XTREMECRM_9999
TELNYX_PUBLIC_KEY=PUB0175DUMMY_PUBLIC_KEY_SIMULATION_MODE
TELNYX_CONNECTION_ID=conn_xtremecrm_demo_sip_webrtc_2026
TELNYX_SIP_DOMAIN=sip.xtremecrm.telnyx.com
TELNYX_OUTBOUND_PROFILE_ID=prof_outbound_fleet_caller_demo

# External Services
GOOGLE_MAPS_API_KEY=
