#!/usr/bin/env bash
# ==============================================================================
# XtremeCRM Native Git Pre-Commit Hook (Ponytail: zero external hook dependencies)
# Runs fast lint & typecheck on backend and frontend before allowing commit.
# ==============================================================================
set -e

echo "🔍 [pre-commit] Checking code quality..."

# 1. Check Backend Lint & Types
echo "⚙️  Linting backend..."
pnpm --dir backend lint --quiet
pnpm --dir backend typecheck

# 2. Check Frontend Lint & Types
echo "🎨 Linting frontend..."
pnpm --dir frontend lint --quiet
pnpm --dir frontend typecheck

echo "✅ [pre-commit] Quality gates passed cleanly!"
exit 0
